{
  "name": "sieve-review",
  "version": "0.4.2",
  "description": "Multi-agent AI code review for Claude Code with an interactive UI: discuss each finding, keep only what matters, publish to GitHub.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sieve": "./cli/sieve.ts"
  },
  "scripts": {
    "dev:ui": "vite --config ui/vite.config.ts",
    "build": "vite build --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p ui/tsconfig.json",
    "test": "bun test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "dompurify": "^3.2.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "lucide-vue-next": "^1.0.0",
    "marked": "^15.0.0",
    "marked-highlight": "^2.2.4",
    "prettier": "^3.9.9",
    "sugar-high": "^2.5.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
